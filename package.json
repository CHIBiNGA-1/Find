{
  "name": "find-campus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts' | tr '\n' ' ')",
    "test:watch": "tsx --test --watch $(find src -name '*.test.ts' | tr '\n' ' ')",
